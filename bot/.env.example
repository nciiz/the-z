DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# رابط اتصال PostgreSQL/YSQL (مثال: YugabyteDB Managed)
DATABASE_URL=postgresql://user:password@host:5433/dbname?sslmode=verify-full
# مسار ملف شهادة الجذر (root.crt) إن كان sslmode=verify-full أو verify-ca
DB_SSL_CA_PATH=../certs/root.crt

# اختياري: إذا حددته سيتم تسجيل الأوامر فوراً على هذا السيرفر فقط (مفيد أثناء التطوير)
DEV_GUILD_ID=
DASHBOARD_URL=http://localhost:3000

# اختياري: مفاتيح الخدمات الخارجية (بدونها تتعطّل الميزة المعنية فقط)
# TMDB_API_KEY=      # ميزة الأفلام (بحث/تفاصيل)
# OMDB_API_KEY=      # تقييم IMDb في ميزة الأفلام
# DEEPL_API_KEY=     # ترجمة DeepL (يوجد بديل Bing تلقائيًا)
# داخل Docker تُشغّل عقدة Lavalink تلقائيًا. للتطوير المحلي اربط عقدتك بهذه القيم:
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=change-me

# مفتاح مشترك بين البوت والداشبورد لتشفير Bot Token الخاص ببوت الموسيقى الثاني.
# ولّده بـ: openssl rand -hex 32 — يجب أن يبقى ثابتًا، وتغييره يتطلب إعادة حفظ التوكن.
MUSIC_BOT_ENCRYPTION_KEY=

# سر توقيع روابط التحميل التي يرسلها الأمر ,dw (يجب أن يطابق نفس المتغير في اللوحة)
# يمكن استخدام NEXTAUTH_SECRET نفسه — عند غياب أي سر، يتطلب التحميل تسجيل دخول اللوحة.
DOWNLOADER_SECRET=

# اختياري: Redis للبيانات المؤقتة عالية التردد (cooldowns / rate limits / عدّادات / كاش).
# عند عدم ضبطه يعمل النظام تلقائيًا على ذاكرة العملية (fallback آمن) مع تحذير واحد.
# إذا تعمل بـ Docker Compose محليًا، استخدم: redis://redis:6379/0
REDIS_URL=
# اختياري: كلمة مرور Redis إذا كان مطلوبًا (لا تُسجَّل في أي log)
# REDIS_PASSWORD=
# اختياري: مهلة الاتصال بالمللي ثانية (الافتراضي 3000)
# REDIS_CONNECT_TIMEOUT_MS=3000
